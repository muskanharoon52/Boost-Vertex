# Google reCAPTCHA v2 Checkbox ("I'm not a robot").
# Site key is public (embedded in the frontend); the secret key stays server-side only.
# RECAPTCHA_ENABLED: true = enforce on POST /api/leads, false = skip (local API testing).
# When unset, verification is enforced only if NODE_ENV=production and a secret key is set.
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_ENABLED=false
# Optional: only accept tokens solved on these hostnames (comma-separated). Leave unset for local.
# RECAPTCHA_ALLOWED_HOSTNAMES=localhost,www.boostvertex.online,boostvertex.online

# Optional: extra allowed browser origins for CORS (comma-separated).
# CLIENT_URL is always allowed; localhost ports are auto-allowed when NODE_ENV is not production.
# CLIENT_URLS=http://localhost:5173,http://localhost:3000
